@startuml

set separator none
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Circ
  .Element-RWxlbWVudCxDaXJj {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 3-3;
    LineThickness: 3;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,External
  .Element-RWxlbWVudCxFeHRlcm5hbA== {
    BackgroundColor: #999999;
    LineColor: #6b6b6b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Element,Hex
  .Element-RWxlbWVudCxIZXg= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 20-20;
    LineThickness: 4;
    FontColor: #444444;
    FontSize: 32;
    HorizontalAlignment: center;
    Shadowing: 10;
    MaximumWidth: 200;
  }
  // Element,Rounded
  .Element-RWxlbWVudCxSb3VuZGVk {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 200;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Dotted
  .Relationship-UmVsYXRpb25zaGlwLERvdHRlZA== {
    LineThickness: 3;
    LineStyle: 3-3;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Solid
  .Relationship-UmVsYXRpb25zaGlwLFNvbGlk {
    LineThickness: 2;
    LineStyle: 0;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Relationship,Thick
  .Relationship-UmVsYXRpb25zaGlwLFRoaWNr {
    LineThickness: 4;
    LineStyle: 20-20;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Shop with a rather long name for wrapping tests
  .Boundary-U2hvcCB3aXRoIGEgcmF0aGVyIGxvbmcgbmFtZSBmb3Igd3JhcHBpbmcgdGVzdHM= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Front
  .Group-RnJvbnQ= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #aa0000;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // Front/Edge
  .Group-RnJvbnQvRWRnZQ== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 2-2;
    LineThickness: 2;
    FontColor: #aa0000;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // transparent element for relationships in legend
  .Element-Transparent {
    BackgroundColor: transparent;
    LineColor: transparent;
    FontColor: transparent;
  }
</style>

rectangle "==Element" <<Element-RWxlbWVudA==>>

storage "==Circ" <<Element-RWxlbWVudCxDaXJj>>

rectangle "==External" <<Element-RWxlbWVudCxFeHRlcm5hbA==>>

hexagon "==Hex" <<Element-RWxlbWVudCxIZXg=>>

rectangle "==Rounded" <<Element-RWxlbWVudCxSb3VuZGVk>>

rectangle "." <<.Element-Transparent>> as 1
1 --> 1 <<Relationship-UmVsYXRpb25zaGlw>> : "Relationship"

rectangle "." <<.Element-Transparent>> as 2
2 --> 2 <<Relationship-UmVsYXRpb25zaGlwLERvdHRlZA==>> : "Dotted"

rectangle "." <<.Element-Transparent>> as 3
3 --> 3 <<Relationship-UmVsYXRpb25zaGlwLFNvbGlk>> : "Solid"

rectangle "." <<.Element-Transparent>> as 4
4 --> 4 <<Relationship-UmVsYXRpb25zaGlwLFRoaWNr>> : "Thick"

@enduml