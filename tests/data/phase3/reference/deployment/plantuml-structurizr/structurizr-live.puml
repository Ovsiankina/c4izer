@startuml
title <size:24>Shop in production</size>

set separator none
top to bottom direction
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Database
  .Element-RWxlbWVudCxEYXRhYmFzZQ== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,External
  .Element-RWxlbWVudCxFeHRlcm5hbA== {
    BackgroundColor: #999999;
    LineColor: #6b6b6b;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Infrastructure Node
  .Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl {
    BackgroundColor: #e8f0e0;
    LineColor: #a2a89c;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Element
  .DeploymentNode-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Cloud\n<size:16>[Deployment Node: AWS]</size>" <<DeploymentNode-RWxlbWVudA==>> as Live.Cloud {
  rectangle "==DNS\n<size:16>[Infrastructure Node: Route 53]</size>\n\nRoutes requests." <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Live.Cloud.DNS
  rectangle "==Load balancer\n<size:16>[Infrastructure Node: ELB]</size>\n\nSpreads requests." <<Element-RWxlbWVudCxJbmZyYXN0cnVjdHVyZSBOb2Rl>> as Live.Cloud.Loadbalancer
  rectangle "Web host (x2)\n<size:16>[Deployment Node: EC2]</size>" <<DeploymentNode-RWxlbWVudA==>> as Live.Cloud.Webhost {
    rectangle "==Web\n<size:16>[Container: Rust]</size>\n\nServes the pages." <<Element-RWxlbWVudA==>> as Live.Cloud.Webhost.Web_1
    rectangle "==Web\n<size:16>[Container: Rust]</size>\n\nServes the pages." <<Element-RWxlbWVudA==>> as Live.Cloud.Webhost.Web_2
  }

  rectangle "Api host (x2..4)\n<size:16>[Deployment Node: EC2]</size>" <<DeploymentNode-RWxlbWVudA==>> as Live.Cloud.Apihost {
    rectangle "==Api\n<size:16>[Container: Rust]</size>\n\nTakes orders." <<Element-RWxlbWVudA==>> as Live.Cloud.Apihost.Api_1
    rectangle "==Api\n<size:16>[Container: Rust]</size>\n\nTakes orders." <<Element-RWxlbWVudA==>> as Live.Cloud.Apihost.Api_2
  }

  rectangle "Database\n<size:16>[Deployment Node: RDS]</size>" <<DeploymentNode-RWxlbWVudA==>> as Live.Cloud.Database {
    database "==Db\n<size:16>[Container: PostgreSQL]</size>\n\nStores orders." <<Element-RWxlbWVudCxEYXRhYmFzZQ==>> as Live.Cloud.Database.Db_1
  }

}

rectangle "Mail provider\n<size:16>[Deployment Node: SaaS]</size>" <<DeploymentNode-RWxlbWVudA==>> as Live.Mailprovider {
  rectangle "==Mail\n<size:16>[Software System]</size>\n\nSends mail." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as Live.Mailprovider.Mail_1
}

Live.Cloud.Webhost.Web_1 --> Live.Cloud.Apihost.Api_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Sends orders to\n<size:16>[JSON/HTTPS]</size>"
Live.Cloud.Webhost.Web_2 --> Live.Cloud.Apihost.Api_2 <<Relationship-UmVsYXRpb25zaGlw>> : "Sends orders to\n<size:16>[JSON/HTTPS]</size>"
Live.Cloud.Apihost.Api_1 --> Live.Cloud.Database.Db_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and writes\n<size:16>[SQL]</size>"
Live.Cloud.Apihost.Api_2 --> Live.Cloud.Database.Db_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and writes\n<size:16>[SQL]</size>"
Live.Cloud.Apihost.Api_1 --> Live.Mailprovider.Mail_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Sends mail through\n<size:16>[SMTP]</size>"
Live.Cloud.Apihost.Api_2 --> Live.Mailprovider.Mail_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Sends mail through\n<size:16>[SMTP]</size>"
Live.Cloud.DNS --> Live.Cloud.Loadbalancer <<Relationship-UmVsYXRpb25zaGlw>> : "Forwards requests to\n<size:16>[HTTPS]</size>"
Live.Cloud.Loadbalancer --> Live.Cloud.Webhost.Web_1 <<Relationship-UmVsYXRpb25zaGlw>> : "Forwards requests to\n<size:16>[HTTPS]</size>"
Live.Cloud.Loadbalancer --> Live.Cloud.Webhost.Web_2 <<Relationship-UmVsYXRpb25zaGlw>> : "Forwards requests to\n<size:16>[HTTPS]</size>"

@enduml