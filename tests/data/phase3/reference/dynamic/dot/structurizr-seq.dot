digraph {
  compound=true
  graph [fontname="Arial", rankdir=TB, ranksep=1.0, nodesep=1.0]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">Dynamic View: System</font><br /><font point-size="24">A request with parallel lookups</font>>

  subgraph cluster_2 {
    margin=25
    label=<<font point-size="24"><br />System</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    3 [id=3,shape=rect, label=<<font point-size="34">App</font><br /><font point-size="19">[Container: Rust]</font><br /><br /><font point-size="24">Handles requests.</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
    6 [id=6,shape=rect, label=<<font point-size="34">Store</font><br /><font point-size="19">[Container: SQL]</font><br /><br /><font point-size="24">Keeps records.</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
  }

  1 [id=1,shape=rect, label=<<font point-size="34">User</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Uses the system.</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]
  7 [id=7,shape=rect, label=<<font point-size="34">Third Party</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Answers lookups.</font>>, style=filled, color="#444444", fillcolor="#ffffff", fontcolor="#444444"]

  1 -> 3 [id=8, label=<<font point-size="24">1. Sends a request</font><br /><font point-size="19">[HTTPS]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  3 -> 6 [id=10, label=<<font point-size="24">2. Reads the record</font><br /><font point-size="19">[SQL]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  3 -> 7 [id=11, label=<<font point-size="24">2. Looks up the rate</font><br /><font point-size="19">[HTTPS]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  3 -> 6 [id=10, label=<<font point-size="24">3. Stores the rate</font><br /><font point-size="19">[SQL]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  6 -> 3 [id=13, label=<<font point-size="24">3. Notifies of the change</font><br /><font point-size="19">[SQL]</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  3 -> 7 [id=11, label=<<font point-size="24">4. Confirms</font><br /><font point-size="19">[HTTPS]</font>>, style="dashed", color="#444444", fontcolor="#444444"]

}