@startuml
title <size:24>Dynamic View: System - App</size>\n<size:24>Form submission inside the app</size>

set separator none
top to bottom direction
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // App
  .Boundary-QXBw {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // System
  .Boundary-U3lzdGVt {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "==User\n<size:16>[Person]</size>\n\nUses the system." <<Element-RWxlbWVudA==>> as User

rectangle "System\n<size:16>[Software System]</size>" <<Boundary-U3lzdGVt>> {
  rectangle "App\n<size:16>[Container: Rust]</size>" <<Boundary-QXBw>> {
    rectangle "==Handler\n<size:16>[Component: Rust]</size>\n\nTakes a request." <<Element-RWxlbWVudA==>> as System.App.Handler
    rectangle "==Validator\n<size:16>[Component: Rust]</size>\n\nChecks input." <<Element-RWxlbWVudA==>> as System.App.Validator
  }

  rectangle "==Store\n<size:16>[Container: SQL]</size>\n\nKeeps records." <<Element-RWxlbWVudA==>> as System.Store
}

rectangle "==User\n<size:16>[Person]</size>\n\nUses the system." <<Element-RWxlbWVudA==>> as User
rectangle "==Store\n<size:16>[Container: SQL]</size>\n\nKeeps records." <<Element-RWxlbWVudA==>> as System.Store

User --> System.App.Handler <<Relationship-UmVsYXRpb25zaGlw>> : "1: Submits a form\n<size:16>[HTTPS]</size>"
System.App.Handler --> System.App.Validator <<Relationship-UmVsYXRpb25zaGlw>> : "2: Validates the form"
System.App.Validator --> System.Store <<Relationship-UmVsYXRpb25zaGlw>> : "3: Checks the record\n<size:16>[SQL]</size>"

@enduml