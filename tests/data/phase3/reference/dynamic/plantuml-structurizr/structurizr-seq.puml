@startuml
title <size:24>Dynamic View: System</size>\n<size:24>A request with parallel lookups</size>

set separator none
top to bottom direction
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // System
  .Boundary-U3lzdGVt {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "System\n<size:16>[Software System]</size>" <<Boundary-U3lzdGVt>> {
  rectangle "==App\n<size:16>[Container: Rust]</size>\n\nHandles requests." <<Element-RWxlbWVudA==>> as System.App
  rectangle "==Store\n<size:16>[Container: SQL]</size>\n\nKeeps records." <<Element-RWxlbWVudA==>> as System.Store
}

rectangle "==User\n<size:16>[Person]</size>\n\nUses the system." <<Element-RWxlbWVudA==>> as User
rectangle "==Third Party\n<size:16>[Software System]</size>\n\nAnswers lookups." <<Element-RWxlbWVudA==>> as ThirdParty

User --> System.App <<Relationship-UmVsYXRpb25zaGlw>> : "1: Sends a request\n<size:16>[HTTPS]</size>"
System.App --> System.Store <<Relationship-UmVsYXRpb25zaGlw>> : "2: Reads the record\n<size:16>[SQL]</size>"
System.App --> ThirdParty <<Relationship-UmVsYXRpb25zaGlw>> : "2: Looks up the rate\n<size:16>[HTTPS]</size>"
System.App --> System.Store <<Relationship-UmVsYXRpb25zaGlw>> : "3: Stores the rate\n<size:16>[SQL]</size>"
System.Store --> System.App <<Relationship-UmVsYXRpb25zaGlw>> : "3: Notifies of the change\n<size:16>[SQL]</size>"
System.App --> ThirdParty <<Relationship-UmVsYXRpb25zaGlw>> : "4: Confirms\n<size:16>[HTTPS]</size>"

@enduml