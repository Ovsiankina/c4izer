digraph {
  compound=true
  graph [fontname="Arial", rankdir=TB, ranksep=1.0, nodesep=1.0]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">Component View: Atomanja - Atomanja server</font><br /><font point-size="24">Component diagram for the Atomanja server: startup, settings and dev data</font>>

  subgraph cluster_7 {
    margin=25
    label=<<font point-size="24"><br />Atomanja</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    subgraph cluster_8 {
      margin=25
      label=<<font point-size="24"><br />Atomanja server</font><br /><font point-size="19">[Container: Rust, axum, HTML + htmx]</font>>
      labelloc=b
      color="#444444"
      fontcolor="#444444"
      fillcolor="#444444"

      10 [id=10,shape=rect, label=<<font point-size="34">web</font><br /><font point-size="19">[Component: Rust, axum, htmx]</font><br /><br /><font point-size="24">HTTP layer: both views, login<br />flows, debt actions, push<br />subscription.</font>>, style=filled, color="#872d08", fillcolor="#c2410c", fontcolor="#ffffff"]
      11 [id=11,shape=rect, label=<<font point-size="34">sync</font><br /><font point-size="19">[Component: Rust, tokio]</font><br /><br /><font point-size="24">Poll loop: fetch, apply to<br />ledger, persist, notify.</font>>, style=filled, color="#872d08", fillcolor="#c2410c", fontcolor="#ffffff"]
      12 [id=12,shape=rect, label=<<font point-size="34">devdata</font><br /><font point-size="19">[Component: Rust module]</font><br /><br /><font point-size="24">Fills the dev database with<br />fake data through the real<br />ledger rules.</font>>, style=filled, color="#872d08", fillcolor="#c2410c", fontcolor="#ffffff"]
      13 [id=13,shape=rect, label=<<font point-size="34">ledger</font><br /><font point-size="19">[Component: Rust module]</font><br /><br /><font point-size="24">Pure domain rules: deadlines,<br />met or late, debts, claims,<br />marks, amount.</font>>, style=filled, color="#205723", fillcolor="#2e7d32", fontcolor="#ffffff"]
      14 [id=14,shape=rect, label=<<font point-size="34">auth</font><br /><font point-size="19">[Component: Rust module]</font><br /><br /><font point-size="24">Pure account rules: roles,<br />password hashing, tokens,<br />permission checks.</font>>, style=filled, color="#205723", fillcolor="#2e7d32", fontcolor="#ffffff"]
      15 [id=15,shape=rect, label=<<font point-size="34">config</font><br /><font point-size="19">[Component: Rust module]</font><br /><br /><font point-size="24">Loads every setting from<br />environment variables at<br />startup.</font>>, style=filled, color="#205723", fillcolor="#2e7d32", fontcolor="#ffffff"]
      16 [id=16,shape=rect, label=<<font point-size="34">vikunja</font><br /><font point-size="19">[Component: Rust, HTTP client]</font><br /><br /><font point-size="24">Read-only Vikunja client. Maps<br />tasks to snapshot records.</font>>, style=filled, color="#155fa0", fillcolor="#1e88e5", fontcolor="#ffffff"]
      17 [id=17,shape=rect, label=<<font point-size="34">notify</font><br /><font point-size="19">[Component: Rust, Web Push]</font><br /><br /><font point-size="24">Turns ledger changes into push<br />notifications. Owns the push<br />keys.</font>>, style=filled, color="#155fa0", fillcolor="#1e88e5", fontcolor="#ffffff"]
      18 [id=18,shape=rect, label=<<font point-size="34">mail</font><br /><font point-size="19">[Component: Rust, SMTP client]</font><br /><br /><font point-size="24">Sends invite and<br />password-reset emails.</font>>, style=filled, color="#155fa0", fillcolor="#1e88e5", fontcolor="#ffffff"]
      19 [id=19,shape=rect, label=<<font point-size="34">store</font><br /><font point-size="19">[Component: Rust, SQLite]</font><br /><br /><font point-size="24">Persistence for ledger and dev<br />databases. Ledger is<br />insert-only.</font>>, style=filled, color="#155fa0", fillcolor="#1e88e5", fontcolor="#ffffff"]
      9 [id=9,shape=rect, label=<<font point-size="34">cli</font><br /><font point-size="19">[Component: Rust binary]</font><br /><br /><font point-size="24">Command line: serve, create<br />accounts, generate push keys,<br />seed dev data.</font>>, style=filled, color="#872d08", fillcolor="#c2410c", fontcolor="#ffffff"]
    }

  }

  9 -> 10 [id=41, label=<<font point-size="24">Starts HTTP server</font>>, style="dashed", color="#444444", fontcolor="#444444"]
  9 -> 11 [id=42, label=<<font point-size="24">Starts poll loop</font>>, style="dashed", color="#444444", fontcolor="#444444"]
