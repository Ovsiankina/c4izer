rectangle "Atomanja\n<size:16>[Software System]</size>" <<Boundary-QXRvbWFuamE=>> {
  rectangle "Atomanja server\n<size:16>[Container: Rust, axum, HTML + htmx]</size>" <<Boundary-QXRvbWFuamEgc2VydmVy>> {
    rectangle "==web\n<size:16>[Component: Rust, axum, htmx]</size>\n\nHTTP layer: both views, login flows, debt actions, push subscription." <<Element-RWxlbWVudCxFbnRyeQ==>> as Atomanja.Atomanjaserver.web
    rectangle "==sync\n<size:16>[Component: Rust, tokio]</size>\n\nPoll loop: fetch, apply to ledger, persist, notify." <<Element-RWxlbWVudCxFbnRyeQ==>> as Atomanja.Atomanjaserver.sync
    rectangle "==devdata\n<size:16>[Component: Rust module]</size>\n\nFills the dev database with fake data through the real ledger rules." <<Element-RWxlbWVudCxFbnRyeQ==>> as Atomanja.Atomanjaserver.devdata
    rectangle "==ledger\n<size:16>[Component: Rust module]</size>\n\nPure domain rules: deadlines, met or late, debts, claims, marks, amount." <<Element-RWxlbWVudCxDb3Jl>> as Atomanja.Atomanjaserver.ledger
    rectangle "==auth\n<size:16>[Component: Rust module]</size>\n\nPure account rules: roles, password hashing, tokens, permission checks." <<Element-RWxlbWVudCxDb3Jl>> as Atomanja.Atomanjaserver.auth
    rectangle "==config\n<size:16>[Component: Rust module]</size>\n\nLoads every setting from environment variables at startup." <<Element-RWxlbWVudCxDb3Jl>> as Atomanja.Atomanjaserver.config
    rectangle "==vikunja\n<size:16>[Component: Rust, HTTP client]</size>\n\nRead-only Vikunja client. Maps tasks to snapshot records." <<Element-RWxlbWVudCxBZGFwdGVy>> as Atomanja.Atomanjaserver.vikunja
    rectangle "==notify\n<size:16>[Component: Rust, Web Push]</size>\n\nTurns ledger changes into push notifications. Owns the push keys." <<Element-RWxlbWVudCxBZGFwdGVy>> as Atomanja.Atomanjaserver.notify
    rectangle "==mail\n<size:16>[Component: Rust, SMTP client]</size>\n\nSends invite and password-reset emails." <<Element-RWxlbWVudCxBZGFwdGVy>> as Atomanja.Atomanjaserver.mail
    rectangle "==store\n<size:16>[Component: Rust, SQLite]</size>\n\nPersistence for ledger and dev databases. Ledger is insert-only." <<Element-RWxlbWVudCxBZGFwdGVy>> as Atomanja.Atomanjaserver.store
    rectangle "==cli\n<size:16>[Component: Rust binary]</size>\n\nCommand line: serve, create accounts, generate push keys, seed dev data." <<Element-RWxlbWVudCxFbnRyeQ==>> as Atomanja.Atomanjaserver.cli
  }

}

